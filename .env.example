# SS TUITIONS — environment template
#
# Copy to `.env` and fill in real values. `.env` is gitignored and must NEVER be committed.
# Every value here is a PLACEHOLDER. Nothing real belongs in this file.

# ---------------------------------------------------------------------------
# CORE
# ---------------------------------------------------------------------------
APP_ENV=development                 # development | staging | production
APP_NAME=SS Tuitions
APP_TIMEZONE=Asia/Kolkata           # CONFIRM: see INTAKE Group B
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# DATABASE (Supabase Postgres)
# Get from: Supabase dashboard -> Project Settings -> Database -> Connection string
# Use the SESSION POOLER string for the app, and the DIRECT string for migrations.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:6543/postgres
DATABASE_DIRECT_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# ---------------------------------------------------------------------------
# AUTH
# Generate JWT_SECRET with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Never reuse the same secret across environments.
# ---------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_GENERATE_A_64_BYTE_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false                 # MUST be true in production (HTTPS only)
COOKIE_SAMESITE=lax
PASSWORD_HASH_SCHEME=argon2id

# ---------------------------------------------------------------------------
# MESSAGING ENCRYPTION
# AES-256-GCM key for message bodies at rest. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# NOTE: the server holds this key and CAN decrypt messages. That is
# deliberate, so admins can review conversations for child safety.
# This is NOT end-to-end encryption and must never be called that.
#
# Losing this key makes every existing message permanently unreadable.
# ---------------------------------------------------------------------------
MESSAGE_ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_48_BYTE_RANDOM_STRING

# ---------------------------------------------------------------------------
# REDIS (rate limiting, sessions, background jobs)
# Upstash free tier: https://upstash.com  -> Redis -> connection string
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=120

# ---------------------------------------------------------------------------
# FILE STORAGE (Supabase Storage, S3-compatible)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SERVICE_ROLE_KEY   # backend only, never sent to browser
SUPABASE_ANON_KEY=CHANGE_ME_ANON_KEY
STORAGE_BUCKET_CONTENT=ss-content                       # worksheets, notes, PYQs
STORAGE_BUCKET_SUBMISSIONS=ss-submissions               # payment proofs, homework uploads
STORAGE_MAX_UPLOAD_MB=25
STORAGE_SIGNED_URL_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# AI
#
# AI_PROVIDER selects which service to use. Leave EMPTY to disable all AI
# features cleanly — the UI hides them rather than showing errors.
#
#   gemini     Google AI Studio FREE tier. 1,500 requests/day, no card needed.
#              Get a key in 2 minutes: https://aistudio.google.com/apikey
#              WARNING: Google may use free-tier data to improve their models.
#              Because students are minors, AI_STRIP_IDENTIFIERS defaults to
#              true so no name, email, phone or ID is ever sent.
#
#   anthropic  Claude. Paid (~$5/month at small volume). Data is NOT used for
#              training. https://console.anthropic.com
# ---------------------------------------------------------------------------
AI_PROVIDER=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

ANTHROPIC_API_KEY=
AI_MODEL_TUTOR=claude-sonnet-5
AI_MODEL_QUESTION_GEN=claude-opus-5
AI_MODEL_VISION=claude-sonnet-5

# Leave this true. Turning it off sends children's names to a third party.
AI_STRIP_IDENTIFIERS=true
# Stops one student exhausting the daily free-tier quota for everyone.
AI_DAILY_MESSAGE_LIMIT_PER_STUDENT=40

# Embeddings for RAG (Voyage AI — Anthropic's recommended embedding provider)
VOYAGE_API_KEY=CHANGE_ME_VOYAGE_API_KEY
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIMENSIONS=1024

# ---------------------------------------------------------------------------
# GOOGLE MEET / CALENDAR
# NOT CONFIGURED YET — requires a Google Workspace account (see INTAKE Group I).
# Until these are filled, class scheduling runs in "unconfigured" mode:
# classes can be created, but no meeting link is generated and the UI says so.
# No fake or placeholder Meet links are ever produced.
# ---------------------------------------------------------------------------
GOOGLE_INTEGRATION_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/meet/oauth/callback
GOOGLE_WORKSPACE_DOMAIN=

# ---------------------------------------------------------------------------
# EMAIL — free, via Gmail SMTP
#
# Gmail allows ~500 messages/day, which is far beyond a tuition business.
# Setup (about 5 minutes, no cost):
#   1. Turn on 2-Step Verification for the sending Google account
#   2. Create an App Password at myaccount.google.com/apppasswords
#   3. Paste it below as EMAIL_SMTP_PASSWORD
#
# An ordinary Gmail password will NOT work — Google blocks it for SMTP.
# ---------------------------------------------------------------------------
# Email transport. Render's free plan blocks outbound SMTP ports (25/465/587),
# so a deployed service must use 'brevo', which sends over HTTPS.
# 'smtp' is fine locally with a Gmail App Password.
EMAIL_PROVIDER=smtp
BREVO_API_KEY=

EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=sstuitions42@gmail.com
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=sstuitions42@gmail.com
EMAIL_FROM_NAME=SS Tuitions

# ---------------------------------------------------------------------------
# PAYMENTS
# Manual UPI/QR verification only. No gateway is integrated.
# A payment is marked paid ONLY by an authenticated admin action — never by an upload.
# Real values come from INTAKE Group F.
# ---------------------------------------------------------------------------
PAYMENTS_MODE=manual_verification   # manual_verification | gateway
PAYMENT_UPI_ID=CONFIGURE_ME
PAYMENT_PAYEE_NAME=CONFIGURE_ME
PAYMENT_QR_IMAGE_PATH=CONFIGURE_ME
PAYMENT_INSTRUCTIONS=CONFIGURE_ME

# ---------------------------------------------------------------------------
# SECURITY
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
AUDIT_LOG_ENABLED=true
FORCE_HTTPS=false                   # MUST be true in production
