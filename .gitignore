# ---- Secrets: never commit ----
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json
service-account*.json

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# ---- Node / Next.js ----
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# ---- ML artifacts ----
# Trained models are versioned in the model registry, not in git
models/*.pkl
models/*.joblib
models/*.onnx
mlruns/

# ---- Uploaded / student data: must never reach the repo ----
uploads/
storage/
*.sqlite
*.db

# ---- OS / editor ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
